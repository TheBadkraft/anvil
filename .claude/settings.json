{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-memcap.py",
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-tdd-pass.py",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
