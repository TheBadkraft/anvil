anvil-schema-script 1
# BR-2610-anvl-schema-005: the root's own @[types] are part of the registry load_from_includes builds (includes contribute A, the root contributes M); load sees only the root's own
file "main.anvl"
|#!aml
|include "a.anvl";
|@[types]
|M := { type := Bool; };
file "a.anvl"
|#!aml
|@[types]
|A := { type := String; size := 1; };
registry r includes "main.anvl"
type find r "A"
type find r "M"
registry s load "main.anvl"
type find s "M"
type find s "A"
