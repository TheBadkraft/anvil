anvil-schema-script 1
# BR-2610-anvl-schema-005: the root's A overrides the included A, reported as a name collision
file "main.anvl"
|#!aml
|include "a.anvl";
|@[types]
|A := { type := Numeric; max := 5; };
file "a.anvl"
|#!aml
|@[types]
|A := { type := Numeric; max := 9; };
registry r includes "main.anvl"
type find r "A"
