anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|f := { type := String; format := iso8601_date; };
schema s load "s.anvl"
validate_value s "{ f := 2026-01-01; }"
validate_value s "{ f := 2026-02-28; }"
validate_value s "{ f := 2026-02-29; }"
validate_value s "{ f := 2024-02-29; }"
validate_value s "{ f := 2100-02-29; }"
validate_value s "{ f := 2000-02-29; }"
validate_value s "{ f := 1900-02-29; }"
validate_value s "{ f := 2026-12-31; }"
validate_value s "{ f := 2026-13-01; }"
validate_value s "{ f := 2026-00-10; }"
validate_value s "{ f := 2026-04-31; }"
validate_value s "{ f := 2026-04-30; }"
validate_value s "{ f := 2026-01-00; }"
validate_value s "{ f := 2026-01-32; }"
validate_value s "{ f := 0000-01-01; }"
validate_value s "{ f := 9999-12-31; }"
validate_value s "{ f := 2026-1-1; }"
validate_value s "{ f := 20260101; }"
validate_value s "{ f := 2026-01-01T00:00:00Z; }"
validate_value s "{ f := 26-01-01; }"
