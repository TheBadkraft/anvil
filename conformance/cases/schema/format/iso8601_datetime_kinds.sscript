anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|f := { type := String; format := iso8601_datetime; };
schema s load "s.anvl"
validate_value s "{ f := 2026-10-29T12:30:00Z; }"
validate_value s "{ f := \"2026-10-29T12:30:00Z\"; }"
validate_value s "{ f := `2026-10-29T12:30:00Z`; }"
validate_value s "{ f := @t`2026-10-29T12:30:00Z`; }"
validate_value s "{ f := ``; }"
validate_value s "{ f := 1; }"
validate_value s "{ f := 1.5; }"
validate_value s "{ f := true; }"
validate_value s "{ f := null; }"
validate_value s "{ f := [\"2026-10-29T12:30:00Z\"]; }"
validate_value s "{ f := (\"2026-10-29T12:30:00Z\", \"2026-10-29T12:30:00Z\"); }"
validate_value s "{ f := { a := 1; }; }"
