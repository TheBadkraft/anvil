anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|a := { type := Numeric; required := true; };
|b := { type := String; };
|c := { type := Bool; required := true; nullable := true; };
schema s load "s.anvl"
validate_value s "{ a := 1; c := true; }"
validate_value s "{ a := "
validate_value s "{ a = 1 }"
validate_value s "{ a := 1 }"
validate_value s ""
validate_value s "   "
validate_value s "{ }"
validate_value s "{ a := 1; } extra"
validate_value s "{ a := 1; }; { b := 2; }"
validate_value s "a := 1;"
validate_value s "{ a := [ ]; }"
validate_value s "{ a := 'x'; }"
validate_value s "{ a := 1; a := 2; }"
validate_value s "{ a := }"
