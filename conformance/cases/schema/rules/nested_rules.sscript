anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|o := { type := Object; fields := { a := { type := Object; fields := { b := { type := Array; items := { type := Object; fields := { c := { type := String; }; }; }; }; }; }; d := { type := Bool; }; }; };
schema s load "s.anvl"
field s "o" "a"
field s "o" "a" "b"
field s "o" "d"
field s "o" "a" "zzz"
field s "o" "d" "x"
