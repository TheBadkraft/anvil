anvil-schema-script 1
file "t.anvl"
|#!aml
|@[types]
|T := { type := String; size := 5; format := uuid; nullable := true; };
|N := { type := Numeric; min := 1; max := 9; integer := true; };
|E := { type := enum; values := [a, b, c]; };
file "s.anvl"
|#!aml
|include "t.anvl";
|@[schema]
|t := { type := types.T; size := 7; format := iso8601_date; nullable := false; };
|n := { type := types.N; min := 3; integer := false; };
|e := { type := types.E; values := [z]; };
schema s load "s.anvl"
validate_value s "{ t := \"2026-01-01\"; n := 2.5; e := z; }"
validate_value s "{ t := null; n := 2; e := a; }"
