anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|f := { type := String; required := true; nullable := true; size := 10; format := "uuid"; values := [a, "b c"]; };
|n := { type := Numeric; integer := true; min := -1.5; max := 2e3; };
|b := { type := Blob; tag := "png"; size := 100; };
|a := { type := Array; min_items := 1; max_items := 9; items := { type := Numeric; }; };
schema s load "s.anvl"
