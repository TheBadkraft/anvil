anvil-schema-script 1
# bound {a:=1;}
file "t.anvl"
|#!aml
|@[types]
|Lo := { type := Numeric; min := { a := 1; }; };
|Hi := { type := Numeric; max := { a := 1; }; };
|Both := { type := Numeric; min := { a := 1; }; max := { a := 1; }; };
registry r load "t.anvl"
type find r "Lo"
type find r "Hi"
type find r "Both"
