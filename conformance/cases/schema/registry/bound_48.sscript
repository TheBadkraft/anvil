anvil-schema-script 1
# bound Infinity
file "t.anvl"
|#!aml
|@[types]
|Lo := { type := Numeric; min := Infinity; };
|Hi := { type := Numeric; max := Infinity; };
|Both := { type := Numeric; min := Infinity; max := Infinity; };
registry r load "t.anvl"
type find r "Lo"
type find r "Hi"
type find r "Both"
