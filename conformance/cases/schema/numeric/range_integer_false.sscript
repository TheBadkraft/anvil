anvil-schema-script 1
# integer := false; min := 0;
file "s.anvl"
|#!aml
|@[schema]
|n := { type := Numeric; integer := false; min := 0; };
schema s load "s.anvl"
validate_value s "{ n := 0; }"
validate_value s "{ n := -0; }"
validate_value s "{ n := -0.0; }"
validate_value s "{ n := 0.0; }"
validate_value s "{ n := 1; }"
validate_value s "{ n := -1; }"
validate_value s "{ n := 0.5; }"
validate_value s "{ n := -0.5; }"
validate_value s "{ n := 2; }"
validate_value s "{ n := 2.0; }"
validate_value s "{ n := 2.5; }"
validate_value s "{ n := 3; }"
validate_value s "{ n := 10; }"
validate_value s "{ n := 10.0; }"
validate_value s "{ n := 10.000000000001; }"
validate_value s "{ n := 11; }"
validate_value s "{ n := 1e1; }"
validate_value s "{ n := 1E1; }"
validate_value s "{ n := 1e+1; }"
validate_value s "{ n := 1e-1; }"
validate_value s "{ n := 100e-1; }"
validate_value s "{ n := 0.1e2; }"
validate_value s "{ n := 9007199254740991; }"
validate_value s "{ n := 9007199254740992; }"
validate_value s "{ n := 9007199254740993; }"
validate_value s "{ n := 9223372036854775807; }"
validate_value s "{ n := 9223372036854775808; }"
validate_value s "{ n := -9223372036854775808; }"
validate_value s "{ n := -9223372036854775809; }"
validate_value s "{ n := 18446744073709551615; }"
validate_value s "{ n := 1e308; }"
validate_value s "{ n := 1.7976931348623157e308; }"
validate_value s "{ n := 1.7976931348623159e308; }"
validate_value s "{ n := 1e999; }"
validate_value s "{ n := -1e999; }"
validate_value s "{ n := 5e-324; }"
validate_value s "{ n := 1e-999; }"
validate_value s "{ n := 007; }"
validate_value s "{ n := -007; }"
validate_value s "{ n := 00010; }"
validate_value s "{ n := 0.30000000000000004; }"
validate_value s "{ n := 999.9999999999999; }"
validate_value s "{ n := 1000; }"
