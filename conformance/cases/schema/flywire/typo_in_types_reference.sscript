anvil-schema-script 1
# a schema that reports a diagnostic would validate less than it says: FlyWire refuses it
file "schema-gen/postgres.types.anvl"
|#!aml
|@[types]
|Int32 := {
|    type := Numeric;
|    min := -2147483648;
|    max := 2147483647;
|    integer := true;
|};
|Str := {
|    type := String;
|};
|Date := {
|    type := String;
|    format := "iso8601_date";
|};
|Int64 := {
|    type := Numeric;
|};
|Timestamptz := {
|    type := String;
|    format := "iso8601_datetime";
|};
|Timestamp := {
|    type := Numeric;
|};
|Text := {
|    type := String;
|};
|Bool := {
|    type := Numeric;
|};
|Float64 := {
|    type := Numeric;
|    min := -1.7976931348623157e+308;
|    max := 1.7976931348623157e+308;
|};
|Uuid := {
|    type := String;
|    format := "uuid";
|};
file "s.anvl"
|#!aml
|include "schema-gen/postgres.types.anvl";
|@[schema]
|asset_id { type := types.Int23; };
schema s load "s.anvl"
validate_value s "{ asset_id := 1; }"
