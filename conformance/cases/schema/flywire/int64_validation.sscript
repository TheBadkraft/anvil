anvil-schema-script 1
file "schema-gen/postgres.types.anvl"
|#!aml
|@[types]
|Int32 := {
|    type := Numeric;
|    min := -2147483648;
|    max := 2147483647;
|    integer := true;
|};
|Str := {
|    type := String;
|};
|Date := {
|    type := String;
|    format := "iso8601_date";
|};
|Int64 := {
|    type := Numeric;
|};
|Timestamptz := {
|    type := String;
|    format := "iso8601_datetime";
|};
|Timestamp := {
|    type := Numeric;
|};
|Text := {
|    type := String;
|};
|Bool := {
|    type := Numeric;
|};
|Float64 := {
|    type := Numeric;
|    min := -1.7976931348623157e+308;
|    max := 1.7976931348623157e+308;
|};
|Uuid := {
|    type := String;
|    format := "uuid";
|};
file "s.anvl"
|#!aml
|include "schema-gen/postgres.types.anvl";
|@[schema, table=t]
|big { type := types.Int64; };
|big_req { type := types.Int64; required := true; };
|f64 { type := types.Float64; };
|ts { type := types.Timestamp; };
|flag { type := types.Bool; };
schema s load "s.anvl"
validate_value s "{ big := 0; }" skip_required
validate_value s "{ big := 9007199254740991; }" skip_required
validate_value s "{ big := 9007199254740992; }" skip_required
validate_value s "{ big := 9007199254740993; }" skip_required
validate_value s "{ big := 9223372036854775807; }" skip_required
validate_value s "{ big := 9223372036854775808; }" skip_required
validate_value s "{ big := -9223372036854775808; }" skip_required
validate_value s "{ big := -9223372036854775809; }" skip_required
validate_value s "{ big := 1.5; }" skip_required
validate_value s "{ big := 1e3; }" skip_required
validate_value s "{ big := 1e30; }" skip_required
validate_value s "{ big := \"9223372036854775807\"; }" skip_required
validate_value s "{ big := \"1\"; }" skip_required
validate_value s "{ big := \"x\"; }" skip_required
validate_value s "{ big := true; }" skip_required
validate_value s "{ big := null; }" skip_required
validate_value s "{ big := 123456789012345678901234567890; }" skip_required
validate_value s "{ f64 := 0; }" skip_required
validate_value s "{ f64 := 1.5; }" skip_required
validate_value s "{ f64 := 1e308; }" skip_required
validate_value s "{ f64 := 1.7976931348623157e308; }" skip_required
validate_value s "{ f64 := 1.7976931348623159e308; }" skip_required
validate_value s "{ f64 := 1e999; }" skip_required
validate_value s "{ f64 := -1e999; }" skip_required
validate_value s "{ f64 := 5e-324; }" skip_required
validate_value s "{ f64 := \"NaN\"; }" skip_required
validate_value s "{ f64 := \"Infinity\"; }" skip_required
validate_value s "{ f64 := NaN; }" skip_required
validate_value s "{ f64 := Infinity; }" skip_required
validate_value s "{ f64 := true; }" skip_required
validate_value s "{ ts := 1700000000; flag := 1; }" skip_required
validate_value s "{ ts := \"2026-10-26T12:00:00\"; flag := 0; }" skip_required
validate_value s "{ ts := 1.5; flag := 2; }" skip_required
validate_value s "{ ts := true; flag := true; }" skip_required
validate_value s "{ ts := null; flag := null; }" skip_required
