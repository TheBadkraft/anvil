anvil-schema-script 1
file "schema-gen/postgres.types.anvl"
|#!aml
|@[types]
|Int32 := {
|    type := Numeric;
|    min := -2147483648;
|    max := 2147483647;
|    integer := true;
|};
|Str := {
|    type := String;
|};
|Date := {
|    type := String;
|    format := "iso8601_date";
|};
|Int64 := {
|    type := Numeric;
|};
|Timestamptz := {
|    type := String;
|    format := "iso8601_datetime";
|};
|Timestamp := {
|    type := Numeric;
|};
|Text := {
|    type := String;
|};
|Bool := {
|    type := Numeric;
|};
|Float64 := {
|    type := Numeric;
|    min := -1.7976931348623157e+308;
|    max := 1.7976931348623157e+308;
|};
|Uuid := {
|    type := String;
|    format := "uuid";
|};
file "b.anvl"
|#!aml
|include "schema-gen/postgres.types.anvl";
|@[schema, table=bounds_fixture]
|
|at_most  { type := types.Int32; max := 4; };
|at_least { type := types.Int32; min := 1; };
|between  { type := types.Int32; min := 1; max := 4; };
schema s load "b.anvl"
validate_value s "{ at_most := 0; at_least := 0; between := 0; }"
validate_value s "{ at_most := 1; at_least := 1; between := 1; }"
validate_value s "{ at_most := 4; at_least := 4; between := 4; }"
validate_value s "{ at_most := 5; at_least := 5; between := 5; }"
validate_value s "{ at_most := -2147483648; at_least := -2147483648; between := -2147483648; }"
validate_value s "{ at_most := 2147483647; at_least := 2147483647; between := 2147483647; }"
validate_value s "{ at_most := 2147483648; at_least := 2147483648; between := 2147483648; }"
validate_value s "{ at_most := 2.5; at_least := 2.5; between := 2.5; }"
validate_value s "{ at_most := 3; at_least := 3; between := 3; }"
