anvil-schema-script 1
file "schema-gen/postgres.types.anvl"
|#!aml
|@[types]
|Int32 := {
|    type := Numeric;
|    min := -2147483648;
|    max := 2147483647;
|    integer := true;
|};
|Str := {
|    type := String;
|};
|Date := {
|    type := String;
|    format := "iso8601_date";
|};
|Int64 := {
|    type := Numeric;
|};
|Timestamptz := {
|    type := String;
|    format := "iso8601_datetime";
|};
|Timestamp := {
|    type := Numeric;
|};
|Text := {
|    type := String;
|};
|Bool := {
|    type := Numeric;
|};
|Float64 := {
|    type := Numeric;
|    min := -1.7976931348623157e+308;
|    max := 1.7976931348623157e+308;
|};
|Uuid := {
|    type := String;
|    format := "uuid";
|};
file "p.anvl"
|#!aml
|include "schema-gen/postgres.types.anvl";
|@[schema, table=pooled_fixture]
|
|id     { type := types.Int32; };
|vin    { type := types.Str; size := 17; ascii := true; };
|make   { pooled := true; };
|status { pooled := true; };
schema s load "p.anvl"
validate_value s "{ id := 1; vin := \"x\"; make := 5; status := [1]; }"
validate_value s "{ make := null; status := { a := 1; }; }"
