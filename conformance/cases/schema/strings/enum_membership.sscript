anvil-schema-script 1
file "s.anvl" "#!aml\n@[schema]\ne := { type := enum; values := [open, \"in progress\", \"\", \"a\x00b\", \"h\xc3\xa9llo\", Closed]; };\n"
schema s load "s.anvl"
validate_value s "{ e := open; }"
validate_value s "{ e := \"open\"; }"
validate_value s "{ e := Open; }"
validate_value s "{ e := closed; }"
validate_value s "{ e := Closed; }"
validate_value s "{ e := \"in progress\"; }"
validate_value s "{ e := \"in  progress\"; }"
validate_value s "{ e := \"\"; }"
validate_value s "{ e := \"a\x00b\"; }"
validate_value s "{ e := \"a\"; }"
validate_value s "{ e := `open`; }"
validate_value s "{ e := @t`open`; }"
validate_value s "{ e := \"h\xc3\xa9llo\"; }"
validate_value s "{ e := \"hello\"; }"
validate_value s "{ e := null; }"
validate_value s "{ e := 1; }"
validate_value s "{ e := true; }"
validate_value s "{ e := [open]; }"
validate_value s "{ e := \"open \"; }"
