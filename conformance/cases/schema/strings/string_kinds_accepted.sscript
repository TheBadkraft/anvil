anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|f := { type := String; };
schema s load "s.anvl"
validate_value s "{ f := \"\"; }"
validate_value s "{ f := \"a\"; }"
validate_value s "{ f := \"abc\"; }"
validate_value s "{ f := \"abcd\"; }"
validate_value s "{ f := \"abcde\"; }"
validate_value s "{ f := \"h\xc3\xa9llo\"; }"
validate_value s "{ f := \"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e\"; }"
validate_value s "{ f := \"\xf0\x9f\x98\x80\"; }"
validate_value s "{ f := \"a\\nb\"; }"
validate_value s "{ f := \"a\\tb\"; }"
validate_value s "{ f := \"a\\\\b\"; }"
validate_value s "{ f := \"a\\\"b\"; }"
validate_value s "{ f := \"a\\xb\"; }"
validate_value s "{ f := \"a\x00b\"; }"
validate_value s "{ f := abc; }"
validate_value s "{ f := abcdef; }"
validate_value s "{ f := 12345; }"
validate_value s "{ f := 123456; }"
validate_value s "{ f := 1.5; }"
validate_value s "{ f := true; }"
validate_value s "{ f := null; }"
validate_value s "{ f := `abc`; }"
validate_value s "{ f := `abcdef`; }"
validate_value s "{ f := @t`abc`; }"
validate_value s "{ f := @tag`abcdef`; }"
validate_value s "{ f := ``; }"
validate_value s "{ f := \"a\nb\nc\"; }"
validate_value s "{ f := \"     \"; }"
validate_value s "{ f := [\"abc\"]; }"
validate_value s "{ f := { a := 1; }; }"
