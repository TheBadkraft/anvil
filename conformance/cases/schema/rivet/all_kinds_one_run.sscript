file "schemas/TASK.schema.anvl"
|#!aml
|include "../types/rivet.types.anvl";
|@[schema]
|
|title := { type := types.Title; required := true; };
|project := { type := types.Slug; required := true; };
|code := { type := types.IdCode; };
|summary := { type := types.Summary; };
|tags := { type := Array; items := { type := types.Tag; }; };
|priority := { type := types.Priority; };
|filed_by := { type := types.Handle; };
|requested_by := { type := types.Handle; };
|assignee := { type := types.Handle; };
|sections := {
|   type := Object;
|   fields := {
|      description := { type := String; };
|      reason := { type := String; };
|      notes := { type := String; };
|   };
|};
file "schemas/actions/comment.schema.anvl"
|#!aml
|include "../../types/rivet.types.anvl";
|@[schema]
|
|id := { type := types.TicketId; required := true; };
|body := { type := String; required := true; };
|internal := { type := Bool; };
schema br load "schemas/BR.schema.anvl"
validate_value br "{ title := \"t\"; project := \"p\"; sections := { notes := \"n\"; design := \"d\"; description := \"x\"; reproduction := \"r\"; }; }"
schema fr load "schemas/FR.schema.anvl"
validate_value fr "{ title := \"t\"; project := \"p\"; sections := { notes := \"n\"; design := \"d\"; description := \"x\"; reproduction := \"r\"; }; }"
schema sr load "schemas/SR.schema.anvl"
validate_value sr "{ title := \"t\"; project := \"p\"; sections := { notes := \"n\"; design := \"d\"; description := \"x\"; reproduction := \"r\"; }; }"
schema task load "schemas/TASK.schema.anvl"
validate_value task "{ title := \"t\"; project := \"p\"; sections := { notes := \"n\"; design := \"d\"; description := \"x\"; reproduction := \"r\"; }; }"
