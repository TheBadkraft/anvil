anvil-schema-script 1
file "s.anvl"
|#!aml
|@[schema]
|t := { type := Tuple; };
|u := { type := Tuple; items := { type := Numeric; }; min_items := 2; };
schema s load "s.anvl"
validate_value s "{ t := (1, 2); u := (1, 2); }"
validate_value s "{ t := [1, 2]; u := [1]; }"
validate_value s "{ t := (1, 2); u := (1, 3); }"
validate_value s "{ t := 1; u := (\"x\", 2); }"
