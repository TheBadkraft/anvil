anvil-builder-script 1
# a nested block form is not a top-level name: the base names nothing (MISSING_BASE)
option on-error continue
dialect AML
let v = int 1
let inner = object
add inner "x" v
let outer = object
let im = add outer "inner" inner
set_block im true
add NULL "outer" outer
let d = object
let dx = int 2
add d "j" dx
let dm = add NULL "derived" d
set_base dm "inner"
emit
