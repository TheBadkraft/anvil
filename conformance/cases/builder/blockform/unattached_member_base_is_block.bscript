anvil-builder-script 1
# a member of an object that is never attached is checked too
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "blk" o
let v = int 1
let loose = object
let inner = object
add inner "x" v
let lm = add loose "n" inner
set_block m true
set_base lm "blk"
emit
