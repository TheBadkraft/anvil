anvil-builder-script 1
# the streaming writer cannot see a block declared after its user; the builder can, and refuses it
option on-error continue
dialect AML
let d = object
let dx = int 2
add d "j" dx
let dm = add NULL "derived" d
set_base dm "blk"
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "blk" o
set_block m true
emit
