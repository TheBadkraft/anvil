anvil-builder-script 1
# the builder is unchanged by the refusal: turning the option off makes the document legal
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "blk" o
let d = object
let dx = int 2
add d "j" dx
let dm = add NULL "derived" d
set_block m true
set_base dm "blk"
emit
set_block m false
emit
