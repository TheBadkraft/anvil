anvil-builder-script 1
# the first member in order is reported
option on-error continue
dialect AML
let n = int 1
add NULL "n" n
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "blk" o
let d = object
let dx = int 2
add d "j" dx
let dm = add NULL "derived" d
let e = object
let ex = int 2
add e "j" ex
let em = add NULL "e" e
set_block m true
set_base dm "blk"
set_base em "n"
emit
