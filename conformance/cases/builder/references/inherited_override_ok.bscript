anvil-builder-script 1
# b overrides f, so a's reference is not walked from b
option on-error continue
dialect AML
let o_a = object
let r_a = varref "b"
add o_a "f" r_a
let m_a = add NULL "a" o_a
let o_b = object
let x_b = int 2
add o_b "f" x_b
let m_b = add NULL "b" o_b
set_base m_b "a"
emit
get_error
