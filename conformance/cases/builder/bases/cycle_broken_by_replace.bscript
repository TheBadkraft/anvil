anvil-builder-script 1
# replacing a base in the cycle by one that names nothing gives MISSING_BASE instead
option on-error continue
dialect AML
let oa = object
let xa = int 1
add oa "f" xa
let ma = add NULL "a" oa
let ob = object
let xb = int 2
add ob "f" xb
let mb = add NULL "b" ob
set_base ma "b"
set_base mb "a"
emit
set_base mb "nothing"
emit
