anvil-builder-script 1
# the check looks at the includes held at emit time
option on-error continue
dialect AML
let oa = object
let xa = int 1
add oa "f" xa
let ma = add NULL "a" oa
let ob = object
let xb = int 2
add ob "f" xb
let mb = add NULL "b" ob
set_base ma "nothere"
emit
include "x.anvl"
emit
