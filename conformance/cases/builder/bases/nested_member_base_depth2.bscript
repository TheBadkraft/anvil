anvil-builder-script 1
# at any depth
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "base" o
let outer = object
let mid = object
let d = object
let x = int 2
add d "j" x
let dm = add mid "derived" d
add outer "mid" mid
set_base dm "base"
add NULL "outer" outer
emit
