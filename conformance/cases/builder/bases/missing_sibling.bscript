anvil-builder-script 1
# a base on a member of an object is refused, whatever it names
option on-error continue
dialect AML
let outer = object
let s = object
let sx = int 1
add s "f" sx
add outer "sib" s
let d = object
let dx = int 2
add d "f" dx
let dm = add outer "der" d
set_base dm "sib"
add NULL "outer" outer
emit
