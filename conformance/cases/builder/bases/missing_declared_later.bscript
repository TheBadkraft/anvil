anvil-builder-script 1
# a base declared after the statement is found
dialect AML
let oa = object
let xa = int 1
add oa "f" xa
let ma = add NULL "a" oa
let ob = object
let xb = int 2
add ob "f" xb
let mb = add NULL "b" ob
set_base ma "later"
let ol = object
let xl = int 3
add ol "f" xl
add NULL "later" ol
emit
