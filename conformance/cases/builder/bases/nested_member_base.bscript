anvil-builder-script 1
# only a top-level member has a base (BR-2611-anvl-resolver-001, the reader's 4022): set_base on a member of an object is refused with NESTED_BASE
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "base" o
let outer = object
let d = object
let x = int 2
add d "j" x
let dm = add outer "derived" d
set_base dm "base"
add NULL "outer" outer
emit
