anvil-builder-script 1
# a refusal changes nothing, however often it is repeated
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "base" o
let outer = object
let d = object
let x = int 2
add d "j" x
let dm = add outer "derived" d
set_base dm "base"
set_base dm "base"
add NULL "outer" outer
emit
get_error
