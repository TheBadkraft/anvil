anvil-builder-script 1
# the refusal is per member: a top-level member still takes a base
option on-error continue
dialect AML
let o_v = int 1
let o = object
add o "k" o_v
let m = add NULL "base" o
let outer = object
let d = object
let x = int 2
add d "j" x
let dm = add outer "derived" d
set_base dm "base"
let t = object
let tx = int 3
add t "z" tx
let tm = add NULL "top" t
set_base tm "base"
add NULL "outer" outer
emit
