anvil-builder-script 1
# the scalar base is reported before the missing one
option on-error continue
dialect AML
let n = int 1
add NULL "n" n
let oa = object
let xa = int 1
add oa "f" xa
let ma = add NULL "p" oa
let ob = object
let xb = int 2
add ob "f" xb
let mb = add NULL "q" ob
set_base ma "gone"
set_base mb "n"
emit
