{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "testPath",
            "description": "Test path (e.g. unit/parser, unit, performance)",
            "default": "unit",
            "type": "promptString"
        }
    ],
    "tasks": [
        {
            "label": "link active test",
            "type": "shell",
            "command": "make",
            "args": [
                "build_${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}